{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/preview.js": {
      "maxDuration": 60
    },
    "api/upload-url.js": {
      "maxDuration": 15
    },
    "api/preview-status/[id].js": {
      "maxDuration": 15
    },
    "api/me/previews.js": {
      "maxDuration": 15
    },
    "api/log.js": {
      "maxDuration": 30
    },
    "api/events.js": {
      "maxDuration": 30
    },
    "api/cron/daily-summary.js": {
      "maxDuration": 30
    },
    "api/share.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "s.booktokids.com" }],
      "destination": "/api/share"
    },
    {
      "source": "/:id([a-z0-9-]{1,40})",
      "has": [{ "type": "host", "value": "s.booktokids.com" }],
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/share",
      "destination": "/api/share"
    },
    {
      "source": "/share/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/upload-url",
      "destination": "/api/upload-url"
    },
    {
      "source": "/preview",
      "destination": "/api/preview"
    },
    {
      "source": "/preview-status/:id",
      "destination": "/api/preview-status/:id"
    },
    {
      "source": "/me/previews",
      "destination": "/api/me/previews"
    },
    {
      "source": "/log",
      "destination": "/api/log"
    },
    {
      "source": "/events",
      "destination": "/api/events"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 6 * * *"
    }
  ]
}
