# ---- Higgsfield (image generation) ----
# Required. "<key id>:<key secret>" from https://console.higgsfield.ai.
# Every cover is generated here (see CHAIN in lib/generate.js).
HIGGSFIELD_KEY=

# ---- fal.ai (image generation, currently off) ----
# fal is not in the generation chain. To bring it back as the last fallback,
# uncomment its entry in CHAIN (lib/generate.js) and these two lines.
# Key from https://fal.ai/dashboard/keys (the "API" preset is enough).
# FAL_KEY=
# Optional. A second fal key on the BILLING preset, used only to read the
# credit balance so fal is skipped at or below $0.10. FAL_KEY can't read it (403).
# FAL_BILLING_KEY=

# ---- Cloudflare R2 (photo + generated cover storage) ----
# S3-compatible. Create a bucket + API token at Cloudflare → R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (R2 public dev URL or a custom domain),
# used to build the GET url the browser + fal can read. No trailing slash.
R2_PUBLIC_BASE_URL=

# ---- Shopify (read the per-book cover + prompt metafields, server-side) ----
# Dev Dashboard app credentials. Scopes: read_products (resolve book cover +
# prompt) and write_customers (tag customers who hit their preview limit).
SHOPIFY_SHOP=your-store.myshopify.com
# New apps use these credentials to obtain a short-lived token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy fallback for an existing admin-created custom app.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ---- Cloudflare Turnstile (bot challenge) ----
# Secret key (the site key lives in the Shopify theme section setting).
TURNSTILE_SECRET=

# ---- Upstash Redis (rate limiting, preview passes, preview history) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Logged-in preview allowance ----
# Shared secret used to verify the HMAC the theme signs for logged-in customers.
# Must match the Shopify theme setting "Preview token secret" exactly
# (Settings → Personalisation). Generate one with: openssl rand -hex 32
# Leave blank to disable the feature - everyone then gets the anonymous tier.
PREVIEW_TOKEN_SECRET=

# ---- Discord channels ----
# One incoming webhook per channel, named DISCORD_WEBHOOK_<CHANNEL>
# (Discord → channel settings → Integrations → Webhooks). Each is a secret:
# anyone holding it can post to that channel. A blank one turns its channel off.
# API and storefront warnings and errors (lib/report.js):
DISCORD_WEBHOOK_LOGS=
# Every preview: the child's photo, then the cover (lib/preview-feed.js):
DISCORD_WEBHOOK_PREVIEWS=
# Visits, carts, checkouts, orders and the daily summary (lib/event-feed.js):
DISCORD_WEBHOOK_EVENTS=
# Every custom story request: the parent's answers and the child's photo, then
# the cover, then the add-to-cart (lib/custom-feed.js):
DISCORD_WEBHOOK_CUSTOM=
# Higgsfield account: live alerts (out of credits, key or model refused) and a
# daily check of the key, cover models, prices and catalog (lib/higgsfield-feed.js):
DISCORD_WEBHOOK_HIGGSFIELD=

# ---- Cron ----
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the daily jobs
# (api/cron/daily-summary.js, api/cron/higgsfield.js). Generate one: openssl rand -hex 32
CRON_SECRET=

# ---- CORS ----
# Comma-separated list of allowed storefront origins. Include the live store,
# the *.myshopify.com domain, and the local theme dev origin.
ALLOWED_ORIGIN=https://your-store.com,https://your-store.myshopify.com,http://127.0.0.1:9292,http://localhost:9292

# ---- Limits ----
MAX_UPLOAD_MB=10

# ---- Share links (api/share.js) ----
# Unset = no short links; the theme shares the full preview URL.
SHARE_BASE_URL=https://s.booktokids.com
# Where an expired short link sends people. Defaults to the first https ALLOWED_ORIGIN.
STORE_URL=https://booktokids.com
