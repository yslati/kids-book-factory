# ---- Higgsfield (image generation) ----
# Required. "<key id>:<key secret>" from https://console.higgsfield.ai.
# Every cover is generated here (see CHAIN in lib/generate.js).
HIGGSFIELD_KEY=

# ---- OpenAI (image generation, under test) ----
# OpenAI is not in the generation chain yet. Higgsfield's Sunburst and Flare
# are OpenAI's gpt-image-2.5-sunburst / -flare resold, so this calls the same
# model directly (lib/openai.js) and gets the exact cost of each cover from the
# token usage in the response. To use it, uncomment its entry in CHAIN
# (lib/generate.js) and set this to a project API key from
# https://platform.openai.com/api-keys. The organisation may need OpenAI's
# one-time verification before GPT Image models answer (403 until then).
# OPENAI_KEY=
# The same key also runs the face check before each cover (lib/face-check.js,
# gpt-5.4-nano, about a hundredth of a cent per photo): a covered or
# unreadable face is refused before anything is paid for. Without the key the
# check is skipped. FACE_CHECK_MODEL overrides the model.
# FACE_CHECK_MODEL=

# ---- fal.ai (image generation, currently off) ----
# fal is not in the generation chain. To bring it back as the last fallback,
# uncomment its entry in CHAIN (lib/generate.js) and this line.
# A full-access key from https://fal.ai/dashboard/keys: it generates covers and
# reads the credit balance, so fal is skipped at or below $0.10. An "API" preset
# key can generate but not read the balance (403), so fal would never be skipped.
# FAL_KEY=

# ---- Child photo ----
# "on" sends the generator a head-and-shoulders crop of the photo
# (lib/child-photo.js). Off by default: a close crop makes the head too big
# for the cover's body. The face is measured for the too-small check either way.
# FACE_CROP=on

# ---- Cloudflare R2 (photo + generated cover storage) ----
# S3-compatible. Create a bucket + API token at Cloudflare → R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (R2 public dev URL or a custom domain),
# used to build the GET url the browser + fal can read. No trailing slash.
R2_PUBLIC_BASE_URL=

# ---- Shopify (read the per-book cover + prompt metafields, server-side) ----
# Dev Dashboard app credentials. Scopes: read_products (resolve book cover +
# prompt) and write_customers (tag customers who hit their preview limit).
SHOPIFY_SHOP=your-store.myshopify.com
# New apps use these credentials to obtain a short-lived token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy fallback for an existing admin-created custom app.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ---- Cloudflare Turnstile (bot challenge) ----
# Secret key (the site key lives in the Shopify theme section setting).
TURNSTILE_SECRET=

# ---- Upstash Redis (rate limiting, preview passes, preview history) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Logged-in preview allowance ----
# Shared secret used to verify the HMAC the theme signs for logged-in customers.
# Must match the Shopify theme setting "Preview token secret" exactly
# (Settings → Personalisation). Generate one with: openssl rand -hex 32
# Leave blank to disable the feature - everyone then gets the anonymous tier.
PREVIEW_TOKEN_SECRET=

# ---- Discord /btk command (api/discord.js) ----
# The Discord app's public key (Developer Portal → General Information) and our
# server's id. The bot token is only for scripts/discord-commands.mjs; keep it
# out of Vercel.
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=

# ---- Discord channels ----
# One incoming webhook per channel, named DISCORD_WEBHOOK_<CHANNEL>
# (Discord → channel settings → Integrations → Webhooks). Each is a secret:
# anyone holding it can post to that channel. A blank one turns its channel off.
# API and storefront warnings and errors (lib/report.js):
DISCORD_WEBHOOK_LOGS=
# Every preview: the child's photo, then the cover (lib/preview-feed.js):
DISCORD_WEBHOOK_PREVIEWS=
# Carts, checkouts, orders and the daily summary (lib/event-feed.js):
DISCORD_WEBHOOK_EVENTS=
# Each new visit on the storefront (lib/event-feed.js):
DISCORD_WEBHOOK_VISITS=
# A visitor opening the storefront chat (Shopify Inbox), with their cover when
# opened from the preview page (lib/chat-feed.js):
DISCORD_WEBHOOK_CHAT=
# Every custom story request: the parent's answers and the child's photo, then
# the cover, then the add-to-cart (lib/custom-feed.js):
DISCORD_WEBHOOK_CUSTOM=
# Higgsfield account: live alerts (out of credits, key or model refused) and a
# daily check of the key, cover models, prices and catalog (lib/higgsfield-feed.js):
DISCORD_WEBHOOK_HIGGSFIELD=
# #fal: daily fal account check (balance, spend). Needs a full-access FAL_KEY.
DISCORD_WEBHOOK_FAL=
# #openai: live alerts (key rejected, not verified, out of credit) and a daily
# check of the key, cover models and exact spend (lib/openai-feed.js). Needs
# OPENAI_KEY.
DISCORD_WEBHOOK_OPENAI=
# #bots, three webhooks in one channel (lib/bot-feed.js, lib/report.js). Each
# falls back to the channel it was split from while blank:
# page views by recognised crawlers and shared links fetched for a preview
# (else #visits):
DISCORD_WEBHOOK_CRAWLERS=
# page views by other automation: headless browsers, scrapers, monitors (else #visits):
DISCORD_WEBHOOK_BOTS=
# #logs reports caused by bots and crawlers (else #logs):
DISCORD_WEBHOOK_BOT_REPORTS=
# Storefront errors in scripts that aren't the theme's (Shopify's, apps',
# extensions') from real visitors (else #logs):
DISCORD_WEBHOOK_THIRD_PARTY=

# ---- Requests sheet (Google Sheets) ----
# One row per cover request from the product pages and the custom story page
# (lib/sheet.js). The URL is the sheet's Apps Script web app
# (sheet/apps-script.js, setup in the README); the secret is the one its setup()
# logs (the SECRET script property). Blank turns it off.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Key Shopify signs store webhooks with (Settings → Notifications → Webhooks).
# When set, orders come from the "Order creation" webhook (api/shopify-webhook.js).
SHOPIFY_WEBHOOK_SECRET=

# ---- Cron ----
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the daily jobs
# (api/cron/daily-summary.js, api/cron/higgsfield.js). Generate one: openssl rand -hex 32
CRON_SECRET=

# ---- CORS ----
# Comma-separated list of allowed storefront origins. Include the live store,
# the *.myshopify.com domain, and the local theme dev origin.
ALLOWED_ORIGIN=https://your-store.com,https://your-store.myshopify.com,http://127.0.0.1:9292,http://localhost:9292

# ---- Limits ----
MAX_UPLOAD_MB=10

# ---- Share links (api/share.js) ----
# Unset = no short links; the theme shares the full preview URL.
SHARE_BASE_URL=https://s.booktokids.com
# Where an expired short link sends people. Defaults to the first https ALLOWED_ORIGIN.
STORE_URL=https://booktokids.com
