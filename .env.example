# ---- fal.ai (image generation) ----
# Required. Create a key at https://fal.ai/dashboard/keys
FAL_KEY=

# ---- Cloudflare R2 (photo + generated cover storage) ----
# S3-compatible. Create a bucket + API token at Cloudflare → R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (R2 public dev URL or a custom domain),
# used to build the GET url the browser + fal can read. No trailing slash.
R2_PUBLIC_BASE_URL=

# ---- Shopify (read the per-book cover + prompt metafields, server-side) ----
# Dev Dashboard app credentials, least-privilege scope: read_products.
SHOPIFY_SHOP=your-store.myshopify.com
# New apps use these credentials to obtain a short-lived token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy fallback for an existing admin-created custom app.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ---- Cloudflare Turnstile (bot challenge) ----
# Secret key (the site key lives in the Shopify theme section setting).
TURNSTILE_SECRET=

# ---- Upstash Redis (rate limiting) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- CORS ----
# Comma-separated list of allowed storefront origins. Include the live store,
# the *.myshopify.com domain, and the local theme dev origin.
ALLOWED_ORIGIN=https://your-store.com,https://your-store.myshopify.com,http://127.0.0.1:9292,http://localhost:9292

# ---- Limits ----
MAX_UPLOAD_MB=10
